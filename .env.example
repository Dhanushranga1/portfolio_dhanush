# ============================================
# STRAPI CMS CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual values.
#
# Local dev: VITE_STRAPI_URL=http://localhost:1337, leave VITE_STRAPI_TOKEN
#   empty (the Public role already has find/findOne on every content type —
#   see portfolio-cms/scripts/seed.ts).
# Production (Vercel): set these as Environment Variables in the Vercel
#   project dashboard, not in a committed .env file.
#   VITE_STRAPI_URL=https://cms.dhanushranga1.dev
#   VITE_STRAPI_TOKEN= (only needed to read draft/unpublished content —
#     generate at Strapi admin -> Settings -> API Tokens -> Read-only)
VITE_STRAPI_URL=
VITE_STRAPI_TOKEN=

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================

# GitHub Token (for Git Timeline page - showing your commits)
# Generate at: https://github.com/settings/tokens (select 'repo' scope)
VITE_GITHUB_TOKEN=

# TMDb API Key (for movie data integration - if using external movie API)
# Get from: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
