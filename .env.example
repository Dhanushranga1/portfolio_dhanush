# Strapi Cloud Configuration
# Copy this file to .env and fill in your values

# Your Strapi Cloud URL (e.g., https://your-project.strapiapp.com)
VITE_STRAPI_URL=

# Your Strapi API Token (generate in Strapi admin: Settings → API Tokens)
VITE_STRAPI_TOKEN=

# GitHub Configuration (optional - for Git Timeline page)
VITE_GITHUB_TOKEN=
