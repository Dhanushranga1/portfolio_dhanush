  id: string;
  title: string;
  slug: string;
  excerpt: string;
  content: string;
  coverImage: string | null;
  category: {
    id: string;
    name: string;
    slug: string;
  } | null;
  tags: string[];
  featured: boolean;
  publishedAt: string;
  updatedAt: string | null;
  readTime: number;
  author: {
    name: string;
    bio: string;
    avatar: string | null;
  };
  seo: {
    metaTitle: string | null;
    metaDescription: string | null;
  } | null;
};

export const BLOG_POSTS: Record<string, BlogPost> = {
  "bringing-ai-to-everyday-projects": {
    id: "1",
    title: "Bringing AI to Everyday Projects",
    slug: "bringing-ai-to-everyday-projects",
    excerpt:
      "How I integrated AI models like GPT-4 and Mistral into real projects. A practical overview of combining LLMs with APIs to make smarter, context-aware applications.",
    content: `# Bringing AI to Everyday Projects

AI isn't just for tech giants anymore. Over the past year, I've integrated LLMs like GPT-4, Mistral, and Gemini into several projects — from chatbots to document assistants. Here's what I learned about making AI actually useful in real-world applications.

## Why Add AI to Your Projects?

The thing about AI models is they're really good at understanding what people actually mean, not just matching keywords. They can have back-and-forth conversations, summarize long documents, and search through content by meaning rather than exact words. That's the kind of stuff that makes apps feel way smarter.

## The Stack I Use

I built most of my AI features with FastAPI on the backend. Since API calls to OpenAI can take a few seconds, async/await is pretty much required. For anything complex like multi-step reasoning or retrieval augmented generation (fancy term for "search docs first, then ask AI"), I use LangChain. It handles the prompt chaining and conversation memory for you.

The other big piece is vector databases. I use FAISS or Pinecone to store document embeddings, which lets users ask questions in plain English and get relevant context before the LLM generates an answer.

## Real Project: TicketPilot

In my TicketPilot project, I built a support assistant that's basically a smart search system. First, I embedded all the support documentation, then when someone asks a question, it finds the most relevant docs and passes them to Gemini along with the question. The AI generates an answer based only on those docs, so it doesn't make stuff up.

The result? Support resolution went from like 45 seconds average to around 8 seconds, and I haven't had any issues with wrong answers since the responses are grounded in actual documentation.

## What I Learned

Prompt engineering is huge. You can't just throw questions at these models and expect good results. I learned to structure prompts carefully — tell it what role it's playing, give it examples, and set clear boundaries like "only answer based on this context."

Cost management was another surprise. GPT-4 is expensive, like really expensive. I switched to GPT-4o-mini for most queries and only use GPT-4 for complex stuff. Cut my API costs by 70%.

Also, these models can fail in interesting ways. Rate limits, timeouts, weird outputs. I added fallback messages for everything now.

## When NOT to Use AI

Look, AI is cool but it's not always the right tool. For simple deterministic tasks, just write normal code. If you need instant responses, LLMs are too slow. And definitely don't let AI make important decisions without human review. It's powerful but it's not magic.

## What's Next

I'm currently exploring fine-tuning models on domain-specific data to make them even better for niche use cases. Also looking into function calling with GPT-4, which lets the model use tools and APIs directly. And honestly, considering running some local models like Llama 3 or Mistral to cut down on API costs entirely.

The main thing I've learned is to start small. Build one feature, see if it actually helps users, then expand from there. AI is powerful but it needs to solve a real problem, not just be AI for the sake of it.

Tools I'm using: OpenAI API, Google Gemini, FAISS, LangChain, and FastAPI for serving everything. Pretty standard stack at this point.`,
    coverImage: "https://images.unsplash.com/photo-1677442136019-21780ecad995?w=1200&h=600&fit=crop",
    category: { id: "2", name: "AI", slug: "ai" },
    tags: ["ai", "llm", "fastapi", "automation"],
    featured: true,
    publishedAt: "2024-11-03T10:00:00Z",
    updatedAt: null,
    readTime: 7,
    author: {
      name: "Dhanush Ranga",
      bio: "Computer Science student building AI-powered applications with FastAPI and modern web technologies",
      avatar: null,
    },
    seo: {
      metaTitle: "Bringing AI to Everyday Projects | Dhanush Ranga",
      metaDescription:
        "Learn how to integrate GPT-4, Mistral, and Gemini into real projects with FastAPI, LangChain, and vector databases.",
    },
  },

  "deploying-fastapi-docker-render": {
    id: "2",
    title: "Deploying FastAPI Apps with Docker & Render",
    slug: "deploying-fastapi-docker-render",
    excerpt:
      "A step-by-step breakdown of how I containerized and deployed my FastAPI apps using Docker and Render. Covers setup, CI/CD integration, and scaling best practices.",
    content: `# Deploying FastAPI Apps with Docker & Render

Deploying a FastAPI app to production seemed daunting at first. But with **Docker** and **Render**, I got my apps live in under an hour. Here's the complete guide from containerization to deployment.

## Why Docker + Render?

**Docker** ensures:
- Consistent environments (dev = staging = prod)
- Easy dependency management
- Portability across cloud providers

**Render** provides:
- Free tier for small projects
- Automatic HTTPS
- Zero-config deployments from Git
- Better than Heroku (RIP free tier)

## Step 1: Dockerize Your FastAPI App

### Project Structure
\`\`\`
project/
├── app/
│   ├── __init__.py
│   ├── main.py
│   └── routes/
├── Dockerfile
├── requirements.txt
└── .dockerignore
\`\`\`

### Dockerfile
\`\`\`dockerfile
FROM python:3.11-slim

WORKDIR /code

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY ./app /code/app

# Expose port
EXPOSE 8000

# Run with Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
\`\`\`

### requirements.txt
\`\`\`
fastapi==0.115.0
uvicorn[standard]==0.30.0
pydantic==2.8.0
python-dotenv==1.0.0
\`\`\`

### .dockerignore
Exclude unnecessary files:
\`\`\`
__pycache__
*.pyc
.env
.git
.venv
*.md
\`\`\`

## Step 2: Test Locally

Build the image:
\`\`\`bash
docker build -t my-fastapi-app .
\`\`\`

Run the container:
\`\`\`bash
docker run -d -p 8000:8000 --name fastapi my-fastapi-app
\`\`\`

Visit \`http://localhost:8000/docs\` to confirm it works.

## Step 3: Push to GitHub

Render deploys directly from Git repos.

\`\`\`bash
git init
git add .
git commit -m "Initial commit"
git branch -M main
git remote add origin https://github.com/username/my-fastapi-app.git
git push -u origin main
\`\`\`

## Step 4: Deploy on Render

1. Go to [Render Dashboard](https://dashboard.render.com/)
2. Click **New +** → **Web Service**
3. Connect your GitHub repo
4. Configure:
   - **Name:** my-fastapi-app
   - **Environment:** Docker
   - **Branch:** main
   - **Dockerfile Path:** ./Dockerfile (default)
5. Click **Create Web Service**

Render automatically:
- Builds your Docker image
- Deploys to a \`.onrender.com\` domain
- Provisions SSL certificates
- Sets up health checks

## Step 5: Environment Variables

For secrets (API keys, DB URLs):
1. Go to **Environment** tab in Render
2. Add variables:
   \`\`\`
   DATABASE_URL=postgresql://...
   SECRET_KEY=your-secret-key
   \`\`\`
3. Redeploy (Render auto-redeploys on env changes)

Access in your app:
\`\`\`python
import os
from dotenv import load_dotenv

load_dotenv()
DATABASE_URL = os.getenv("DATABASE_URL")
\`\`\`

## Step 6: CI/CD with Render

Render auto-deploys on every push to \`main\`. For more control:

### Deploy on Tag
In Render settings:
- **Auto-Deploy:** No
- Use Render's CLI or API to trigger deploys on release tags

\`\`\`bash
git tag v1.0.0
git push origin v1.0.0
# Manually trigger deploy via Render dashboard
\`\`\`

## Production Best Practices

### 1. **Health Checks**
Add a health endpoint:
\`\`\`python
@app.get("/health")
def health_check():
    return {"status": "ok"}
\`\`\`

### 2. **Logging**
Use structured logs:
\`\`\`python
import logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

@app.get("/")
def root():
    logger.info("Root endpoint accessed")
    return {"message": "Hello World"}
\`\`\`

### 3. **Gunicorn for Production**
For better performance, use Gunicorn with Uvicorn workers:

\`\`\`dockerfile
CMD ["gunicorn", "app.main:app", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]
\`\`\`

Update requirements.txt:
\`\`\`
gunicorn==21.2.0
\`\`\`

### 4. **Database Migrations**
Use Alembic for schema changes:
\`\`\`bash
alembic upgrade head
\`\`\`

Run in Dockerfile:
\`\`\`dockerfile
RUN alembic upgrade head
\`\`\`

## Scaling on Render

Render offers:
- **Horizontal scaling** — add more instances
- **Vertical scaling** — upgrade to larger instances

For my TicketPilot app (1K req/day), the free tier suffices. For production loads, I use the \$7/month Starter plan.

## Cost Comparison

| Service | Free Tier | Paid |
|---------|-----------|------|
| Render | 750 hrs/month | \$7/month |
| Railway | \$5 credit | \$0.000463/GB-hr |
| Fly.io | 3 VMs | \$1.94/month/VM |

Render wins for simplicity and generous free tier.

## Lessons Learned

1. **Start with Docker** — even if you deploy elsewhere later
2. **Use .env files locally**, environment variables in prod
3. **Automate deployments** — manual deploys = human error
4. **Monitor logs** — Render's built-in logs are good enough
5. **Don't over-optimize early** — free tier is fine for MVPs

## Next Steps

I'm exploring:
- **AWS ECS** for larger-scale deployments
- **Kubernetes** (overkill for now, but learning)
- **Database connection pooling** with PgBouncer

Happy deploying! 🚢`,
    coverImage: "https://images.unsplash.com/photo-1605745341112-85968b19335b?w=1200&h=600&fit=crop",
    category: { id: "1", name: "Development", slug: "development" },
    tags: ["fastapi", "docker", "backend", "deployment"],
    featured: true,
    publishedAt: "2024-11-06T14:30:00Z",
    updatedAt: null,
    readTime: 9,
    author: {
      name: "Dhanush Ranga",
      bio: "Computer Science student building AI-powered applications with FastAPI and modern web technologies",
      avatar: null,
    },
    seo: {
      metaTitle: "Deploying FastAPI Apps with Docker & Render | Dhanush Ranga",
      metaDescription:
        "Complete guide to containerizing and deploying FastAPI applications with Docker and Render, including CI/CD and production best practices.",
    },
  },

  "how-i-built-scrubpy": {
    id: "3",
    title: "How I Built ScrubPy — A Data Cleaning Library in Python",
    slug: "how-i-built-scrubpy",
    excerpt:
      "A behind-the-scenes look at ScrubPy — my open-source Python package for quick data cleaning. The motivation, design choices, and lessons from publishing to PyPI.",
    content: `# How I Built ScrubPy

**ScrubPy** is my open-source Python library for data cleaning. It handles common pandas tasks (missing values, duplicates, outliers) with a single function call. Here's why I built it and what I learned from publishing to PyPI.

🔗 [**PyPI Package**](https://pypi.org/project/scrubpy/)
🔗 [**GitHub Repo**](https://github.com/Dhanushranga1/scrubpy)

## The Problem

Data cleaning is repetitive. Every project starts the same way:

\`\`\`python
import pandas as pd

df = pd.read_csv("data.csv")
df.drop_duplicates(inplace=True)
df.fillna(df.mean(), inplace=True)
# ... 20 more lines of boilerplate
\`\`\`

I wanted **one function** that does all of this:
\`\`\`python
from scrubpy import clean

df = clean(df)  # Done.
\`\`\`

## Design Principles

### 1. **Sensible Defaults**
ScrubPy assumes you want:
- Drop duplicate rows
- Fill missing values (mean for numeric, mode for categorical)
- Remove outliers (IQR method)
- Strip whitespace from strings

But everything is configurable:
\`\`\`python
df = clean(df, remove_duplicates=False, fill_method="median")
\`\`\`

### 2. **Composability**
Each operation is a separate function:
\`\`\`python
from scrubpy import remove_outliers, fill_missing

df = df.pipe(remove_outliers).pipe(fill_missing)
\`\`\`

### 3. **Non-Destructive by Default**
Operations return a copy unless \`inplace=True\`:
\`\`\`python
clean_df = clean(df)  # Original df unchanged
\`\`\`

## Implementation Highlights

### Handling Missing Values
\`\`\`python
def fill_missing(df, strategy="auto", inplace=False):
    """
    Fill missing values.
    
    strategy: 'auto', 'mean', 'median', 'mode', or a scalar value
    """
    if not inplace:
        df = df.copy()
    
    for col in df.columns:
        if df[col].isnull().any():
            if strategy == "auto":
                if pd.api.types.is_numeric_dtype(df[col]):
                    df[col].fillna(df[col].mean(), inplace=True)
                else:
                    df[col].fillna(df[col].mode()[0], inplace=True)
            elif strategy == "mean":
                df[col].fillna(df[col].mean(), inplace=True)
            # ... other strategies
    
    return df
\`\`\`

### Outlier Detection (IQR Method)
\`\`\`python
def remove_outliers(df, threshold=1.5, inplace=False):
    """Remove outliers using Interquartile Range method."""
    if not inplace:
        df = df.copy()
    
    for col in df.select_dtypes(include=['number']).columns:
        Q1 = df[col].quantile(0.25)
        Q3 = df[col].quantile(0.75)
        IQR = Q3 - Q1
        lower_bound = Q1 - threshold * IQR
        upper_bound = Q3 + threshold * IQR
        df = df[(df[col] >= lower_bound) & (df[col] <= upper_bound)]
    
    return df
\`\`\`

## Publishing to PyPI

### 1. **Project Structure**
\`\`\`
scrubpy/
├── scrubpy/
│   ├── __init__.py
│   ├── core.py
│   └── utils.py
├── tests/
│   └── test_core.py
├── setup.py
├── README.md
├── LICENSE
└── .gitignore
\`\`\`

### 2. **setup.py**
\`\`\`python
from setuptools import setup, find_packages

setup(
    name="scrubpy",
    version="0.1.0",
    author="Dhanush Ranga",
    description="Quick data cleaning for pandas DataFrames",
    long_description=open("README.md").read(),
    long_description_content_type="text/markdown",
    url="https://github.com/Dhanushranga1/scrubpy",
    packages=find_packages(),
    install_requires=["pandas>=1.3.0"],
    classifiers=[
        "Programming Language :: Python :: 3",
        "License :: OSI Approved :: MIT License",
    ],
    python_requires=">=3.8",
)
\`\`\`

### 3. **Build and Upload**
\`\`\`bash
# Build distribution files
python setup.py sdist bdist_wheel

# Upload to PyPI
pip install twine
twine upload dist/*
\`\`\`

### 4. **Testing with pytest**
\`\`\`python
import pandas as pd
from scrubpy import clean

def test_remove_duplicates():
    df = pd.DataFrame({"A": [1, 1, 2], "B": [3, 3, 4]})
    result = clean(df)
    assert len(result) == 2
\`\`\`

Run tests:
\`\`\`bash
pytest tests/
\`\`\`

## Usage Examples

### Basic Cleaning
\`\`\`python
import pandas as pd
from scrubpy import clean

df = pd.read_csv("messy_data.csv")
df = clean(df)
\`\`\`

### Custom Configuration
\`\`\`python
df = clean(
    df,
    remove_duplicates=True,
    fill_method="median",
    outlier_threshold=2.0,
    strip_whitespace=True
)
\`\`\`

## Lessons Learned

### 1. **Documentation is Key**
Good docstrings + README = more users. I spent 40% of my time on docs.

### 2. **Version Pinning**
Specify minimum versions in \`install_requires\`:
\`\`\`python
install_requires=["pandas>=1.3.0", "numpy>=1.21.0"]
\`\`\`

### 3. **CI/CD with GitHub Actions**
Automate testing and publishing:
\`\`\`.yaml
name: Test and Publish

on: [push, pull_request]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2
      - uses: actions/setup-python@v2
      - run: pip install -r requirements.txt
      - run: pytest
\`\`\`

### 4. **Semantic Versioning**
Follow [SemVer](https://semver.org/):
- \`0.1.0\` → Initial release
- \`0.1.1\` → Bug fix
- \`0.2.0\` → New feature
- \`1.0.0\` → Stable API

### 5. **User Feedback is Gold**
I got feature requests via GitHub Issues. Users wanted:
- Column-specific cleaning
- Custom fill values
- Export cleaned data stats

All added in v0.2.0.

## What's Next?

Future features:
- **Schema validation** (enforce dtypes)
- **Automated reports** (summary of cleaning operations)
- **CLI tool** (\`scrubpy clean data.csv --output clean.csv\`)

## Try It Out

Install:
\`\`\`bash
pip install scrubpy
\`\`\`

Basic usage:
\`\`\`python
from scrubpy import clean
import pandas as pd

df = pd.read_csv("your_data.csv")
df = clean(df)
\`\`\`

Star the repo if you find it useful! ⭐

---

Building an open-source library taught me more than any tutorial. Start small, solve your own problem, and ship it.`,
    coverImage: "https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=1200&h=600&fit=crop",
    category: { id: "4", name: "Tech", slug: "tech" },
    tags: ["python", "pandas", "data-cleaning", "pypi"],
    featured: true,
    publishedAt: "2024-11-10T09:00:00Z",
    updatedAt: null,
    readTime: 8,
    author: {
      name: "Dhanush Ranga",
      bio: "Computer Science student building AI-powered applications with FastAPI and modern web technologies",
      avatar: null,
    },
    seo: {
      metaTitle: "How I Built ScrubPy — A Python Data Cleaning Library | Dhanush Ranga",
      metaDescription:
        "Behind-the-scenes look at building and publishing ScrubPy, an open-source Python library for pandas data cleaning, to PyPI.",
    },
  },

  "my-journey-cloud-devops": {
    id: "4",
    title: "My Journey into Cloud & DevOps",
    slug: "my-journey-cloud-devops",
    excerpt:
      "Reflecting on my first real experience with AWS, Terraform, and Kubernetes. From setting up EC2 and RDS to automating deployments — lessons I learned while building CineReads.",
    content: `# My Journey into Cloud & DevOps

Six months ago, I knew **nothing** about cloud infrastructure. Today, I'm managing AWS services, writing Terraform configs, and automating deployments. Here's what I learned building [CineReads](https://cinereads.dhanushranga1.dev/) — my full-stack movie recommendation app.

## Why I Dove Into DevOps

As a CS student, I'd always deployed to free platforms (Vercel, Render). But for CineReads, I needed:
- **PostgreSQL database** (too large for free tiers)
- **Background jobs** (for data processing)
- **Full control** (custom domains, env configs)

AWS was intimidating, but I committed to learning it properly.

## The Stack

### **AWS Services Used**
- **EC2** — Application servers
- **RDS (PostgreSQL)** — Database
- **S3** — Static assets (movie posters)
- **Route 53** — DNS management
- **CloudFront** — CDN for faster delivery
- **IAM** — Access control

### **Infrastructure as Code**
- **Terraform** — Manage all resources as code
- **Docker** — Containerize the app
- **GitHub Actions** — CI/CD pipeline

## Phase 1: Manual Setup (The Hard Way)

I started by clicking through the AWS Console. Bad idea.

### EC2 Instance
1. Launch Ubuntu 22.04 instance (\`t2.micro\` for free tier)
2. SSH in: \`ssh -i key.pem ubuntu@ec2-ip\`
3. Install dependencies:
   \`\`\`bash
   sudo apt update
   sudo apt install python3-pip postgresql-client
   pip install -r requirements.txt
   \`\`\`
4. Run app: \`uvicorn main:app --host 0.0.0.0\`

**Problems:**
- Instance state not reproducible
- Manual updates = downtime
- No version control for infra

## Phase 2: Dockerize Everything

Created a \`Dockerfile\`:
\`\`\`dockerfile
FROM python:3.11-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0"]
\`\`\`

Build and push to Docker Hub:
\`\`\`bash
docker build -t dhanush/cinereads:latest .
docker push dhanush/cinereads:latest
\`\`\`

On EC2, just run:
\`\`\`bash
docker pull dhanush/cinereads:latest
docker run -d -p 80:8000 dhanush/cinereads:latest
\`\`\`

**Benefits:**
- Consistent environment
- Easy rollbacks (\`docker pull dhanush/cinereads:v1.2\`)
- Faster deployments

## Phase 3: Infrastructure as Code with Terraform

Hand-managing AWS resources was error-prone. Enter **Terraform**.

### \`main.tf\` (simplified)
\`\`\`hcl
provider "aws" {
  region = "us-east-1"
}

# EC2 Instance
resource "aws_instance" "app_server" {
  ami           = "ami-0c55b159cbfafe1f0"  # Ubuntu 22.04
  instance_type = "t2.micro"
  
  tags = {
    Name = "CineReads-App"
  }
}

# RDS Database
resource "aws_db_instance" "postgres" {
  allocated_storage = 20
  engine            = "postgres"
  engine_version    = "15.3"
  instance_class    = "db.t3.micro"
  username          = var.db_username
  password          = var.db_password
  
  tags = {
    Name = "CineReads-DB"
  }
}

# S3 Bucket for static assets
resource "aws_s3_bucket" "assets" {
  bucket = "cinereads-assets"
}
\`\`\`

Deploy with:
\`\`\`bash
terraform init
terraform plan
terraform apply
\`\`\`

**Why Terraform Rocks:**
- Version control for infrastructure
- Preview changes before applying
- Destroy resources cleanly: \`terraform destroy\`

## Phase 4: CI/CD with GitHub Actions

Manual deployments are tedious. I automated with GitHub Actions.

### \`.github/workflows/deploy.yml\`
\`\`\`yaml
name: Deploy to AWS

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v2
      
      - name: Build Docker image
        run: docker build -t dhanush/cinereads:latest .
      
      - name: Push to Docker Hub
        run: |
          echo \${{ secrets.DOCKER_PASSWORD }} | docker login -u dhanush --password-stdin
          docker push dhanush/cinereads:latest
      
      - name: Deploy to EC2
        uses: appleboy/ssh-action@master
        with:
          host: \${{ secrets.EC2_HOST }}
          username: ubuntu
          key: \${{ secrets.EC2_SSH_KEY }}
          script: |
            docker pull dhanush/cinereads:latest
            docker stop cinereads || true
            docker rm cinereads || true
            docker run -d --name cinereads -p 80:8000 dhanush/cinereads:latest
\`\`\`

Now every push to \`main\` triggers an automatic deployment. 🎉

## Phase 5: Monitoring & Logging

Running in production means things will break. I added:

### **CloudWatch Logs**
Ship container logs to AWS CloudWatch:
\`\`\`bash
docker run -d --log-driver=awslogs --log-opt awslogs-group=cinereads ...
\`\`\`

### **Health Checks**
Added a \`/health\` endpoint:
\`\`\`python
@app.get("/health")
def health_check():
    return {"status": "ok", "db": check_db_connection()}
\`\`\`

Set up AWS Route 53 health checks to monitor uptime.

## Lessons Learned

### 1. **Start Small**
Don't jump to Kubernetes on day one. EC2 + Docker is fine for most projects.

### 2. **Automate Early**
Manual deployments = bugs. Set up CI/CD from the start.

### 3. **Use Free Tiers Wisely**
AWS free tier includes:
- 750 hrs/month of EC2 (\`t2.micro\`)
- 20 GB of RDS storage
- 5 GB of S3

### 4. **Security Matters**
- **Never commit secrets** (use AWS Secrets Manager or GitHub Secrets)
- **Use IAM roles** instead of hardcoding credentials
- **Enable MFA** on root account

### 5. **Cost Monitoring**
Set up billing alerts! I got a \$30 surprise bill because I forgot to stop an RDS instance.

### 6. **Documentation is Your Friend**
AWS docs are dense but comprehensive. Also useful:
- [Terraform AWS Provider Docs](https://registry.terraform.io/providers/hashicorp/aws/latest/docs)
- [DigitalOcean's DevOps Tutorials](https://www.digitalocean.com/community/tutorials)

## What's Next?

I'm exploring:
- **Kubernetes** (EKS) for container orchestration
- **Terraform modules** for reusable infra
- **AWS Lambda** for serverless functions
- **Monitoring with Prometheus + Grafana**

## Resources I Used

**Books:**
- *The Phoenix Project* (DevOps fundamentals)
- *Terraform: Up & Running* by Yevgeniy Brikman

**Courses:**
- AWS Cloud Practitioner (free)
- Terraform Associate Certification

**Communities:**
- r/devops on Reddit
- DevOps Discord servers

---

DevOps felt overwhelming at first, but breaking it into phases (manual → Docker → IaC → CI/CD) made it manageable. Start with one project and build from there.

You've got this! 🚀`,
