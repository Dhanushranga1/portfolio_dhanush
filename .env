# ============================================
# LOCAL STRAPI CONFIGURATION
# ============================================
# Local Strapi CMS running on your machine
# The Strapi admin panel is at: http://localhost:1337/admin

# Local Strapi URL
VITE_STRAPI_URL=http://localhost:1337

# Leave token empty for now (will generate after first login)
VITE_STRAPI_TOKEN=

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================

# GitHub Token (for Git Timeline page)
VITE_GITHUB_TOKEN=

# TMDb API Key (for movie data)
VITE_TMDB_API_KEY=
