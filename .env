# ============================================
# LOCAL STRAPI CONFIGURATION
# ============================================
# Local Strapi CMS running on your machine
# The Strapi admin panel is at: http://localhost:1337/admin

# Local Strapi URL
VITE_STRAPI_URL=http://localhost:1337

# Strapi API Token: leave empty for local dev — Public role has find/findOne
# access to all content types (see portfolio-cms/scripts/seed.ts). Only set
# this to a real token generated from Settings -> API Tokens if you need
# access to unpublished/draft content.
VITE_STRAPI_TOKEN=

# ============================================
# OPTIONAL INTEGRATIONS
# ============================================

# GitHub Token (for Git Timeline page)
VITE_GITHUB_TOKEN=

